{
  "name": "@zakkster/lite-worker",
  "version": "1.4.0",
  "description": "Zero-GC per-frame worker channel. Define a worker inline from a function, message it with transferables, keep the main thread clean at 60fps. Zero dependencies, single file.",
  "type": "module",
  "main": "./Worker.js",
  "module": "./Worker.js",
  "types": "./Worker.d.ts",
  "exports": {
    ".": {
      "types": "./Worker.d.ts",
      "node": "./Worker.js",
      "import": "./Worker.js",
      "default": "./Worker.js"
    }
  },
  "files": [
    "Worker.js",
    "Worker.d.ts",
    "llms.txt",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/Worker.test.js",
    "check": "node --check Worker.js && tsc --noEmit --strict Worker.d.ts",
    "gate": "node --expose-gc bench/gc-gate.mjs",
    "soak": "node --expose-gc bench/frame-soak.mjs",
    "torture": "node --expose-gc test/torture.mjs"
  },
  "keywords": [
    "worker",
    "web-worker",
    "offscreen",
    "transferable",
    "zero-gc",
    "60fps",
    "inline-worker",
    "blob-worker",
    "rpc",
    "frame-channel",
    "double-buffer",
    "backpressure",
    "latest-wins",
    "cross-origin-isolated",
    "seqlock",
    "atomics",
    "sharedarraybuffer",
    "offscreencanvas",
    "transfercontroltooffscreen",
    "esm",
    "single-file",
    "lite"
  ],
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-worker.git"
  },
  "homepage": "https://github.com/PeshoVurtoleta/lite-worker#readme",
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-worker/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.11.0",
    "@zakkster/lite-leak": "^1.8.1"
  }
}
